# Copy this file to .env (same folder) and fill in your key. The server reads it automatically.

# Which LLM powers the Condition Processor / Encoding Determination agents: "anthropic" or "openai".
BO_PLATFORM_LLM_PROVIDER=anthropic

# Anthropic Claude (used when BO_PLATFORM_LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
BO_PLATFORM_ANTHROPIC_MODEL=claude-opus-4-5-20251101

# OpenAI (used when BO_PLATFORM_LLM_PROVIDER=openai)
OPENAI_API_KEY=
BO_PLATFORM_OPENAI_MODEL=gpt-5

# Where synthesis_data/, battery_data/, training_data_clean.xlsx, bo_runs/ live.
# Leave unset to default to the folder that contains this backend/ folder (i.e. next to index.html).
# BO_PLATFORM_WORKDIR=/absolute/path/to/your/project/folder

# Parameters Filter: dominant-value-share above which a parameter is treated as constant.
BO_PLATFORM_PARAM_THRESHOLD=0.90

# Near-duplicate / collinearity hint threshold (max of |Pearson r|, |Spearman rho|).
BO_PLATFORM_DUPLICATE_THRESHOLD=0.90

# Comma-separated list of allowed CORS origins for the frontend HTML file. "*" is fine for local use.
BO_PLATFORM_CORS_ORIGINS=*
